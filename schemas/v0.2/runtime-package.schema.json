{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everendforge.github.io/spec/schemas/v0.2/runtime-package.schema.json",
  "title": "Everend Runtime Package v0.2",
  "type": "object",
  "required": ["specVersion", "packageId", "entryNodeId", "nodes", "primaryLocale", "localizations"],
  "properties": {
    "specVersion": { "enum": ["0.1", "0.2"] },
    "packageId": { "type": "string", "minLength": 1 },
    "entryNodeId": { "type": "string", "minLength": 1 },
    "primaryLocale": { "type": "string", "minLength": 2 },
    "localization": { "type": "object", "additionalProperties": { "type": "string" } },
    "localizations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "textKey": { "type": "string" },
          "characterRef": { "type": "string" },
          "speakerRef": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
